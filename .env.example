USE_MOCK=true
PUBLIC_SITE_URL=https://focifred.es
# Número de WhatsApp Business con prefijo de país, sin + ni espacios. Ejemplo: 34612345678
PUBLIC_WHATSAPP_NUMBER=
# Clave de CallMeBot, solo en el servidor. El cliente no abre WhatsApp: el aviso se envía a este número.
# Activación, una sola vez, desde el WhatsApp del negocio: guardar el contacto +34 623 78 64 49 y enviar
# "I allow callmebot to send me messages". La clave llega en la respuesta del bot.
CALLMEBOT_APIKEY=
PUBLIC_PHONE=
PUBLIC_EMAIL=hola@focifred.es
PUBLIC_LEGAL_NAME=
PUBLIC_NIF=
PUBLIC_ADDRESS=Barcelona
# Opcional, para Google Ads. El aviso de cookies ya deja la medición apagada hasta que la persona acepta.
PUBLIC_GA_ID=
PUBLIC_ADS_ID=
API_URL=
