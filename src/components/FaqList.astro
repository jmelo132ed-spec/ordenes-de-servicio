---
import { getFaqs } from "../services/api";

const faqs = await getFaqs();
---

<section class="mx-auto max-w-6xl px-4 py-16 md:px-6" aria-labelledby="faq-titulo">
  <h2 id="faq-titulo" class="font-serif text-4xl">Antes de escribirnos</h2>
  <div class="mt-6 divide-y divide-line border-y border-line">
    {faqs.map((faq) => (
      <details class="group py-4">
        <summary class="cursor-pointer list-none font-semibold text-ink marker:content-none">
          <span class="flex items-center justify-between gap-4">
            {faq.question}
            <span class="text-frost group-open:rotate-45" aria-hidden="true">+</span>
          </span>
        </summary>
        <p class="max-w-3xl pt-3 text-ink-soft">{faq.answer}</p>
      </details>
    ))}
  </div>
</section>
