---
interface Props {
  title: string;
  text: string;
  href?: string;
  label?: string;
}
const { title, text, href = "/solicitar", label = "Pedir servicio" } = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 pb-16 md:px-6">
  <div class="flex flex-col items-start justify-between gap-6 rounded-[1.6rem] border border-line bg-card px-6 py-8 md:flex-row md:items-center md:px-10">
    <div>
      <h2 class="font-serif text-4xl">{title}</h2>
      <p class="mt-2 max-w-xl text-ink-soft">{text}</p>
    </div>
    <a class="rounded-full bg-ember px-5 py-3 font-bold text-white hover:bg-ember-ink" href={href}>{label}</a>
  </div>
</section>
