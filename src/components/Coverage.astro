---
import { getZones } from "../services/api";

const zones = getZones();
---

<section class="mx-auto max-w-6xl px-4 py-4 md:px-6" aria-labelledby="zonas-titulo">
  <div class="rounded-[1.6rem] bg-frost-deep px-6 py-10 text-white md:px-10">
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-white/60">Cobertura</p>
    <h2 id="zonas-titulo" class="mt-2 max-w-xl font-serif text-4xl">Barcelona ciudad y el área de al lado.</h2>
    <div class="mt-8 grid gap-8 md:grid-cols-2">
      <div>
        <h3 class="text-sm font-bold uppercase tracking-[0.14em] text-white/60">Distritos</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {zones.city.map((zone) => (
            <li class="rounded-full bg-white/10 px-3 py-1 text-sm">{zone}</li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-bold uppercase tracking-[0.14em] text-white/60">Área metropolitana</h3>
        <ul class="mt-3 flex flex-wrap gap-2">
          {zones.metro.map((zone) => (
            <li class="rounded-full bg-white/10 px-3 py-1 text-sm">{zone}</li>
          ))}
        </ul>
      </div>
    </div>
    <a class="mt-8 inline-flex rounded-full bg-white px-4 py-2 text-sm font-bold text-frost-deep" href="/zonas">Ver zonas y pedir desde la tuya</a>
  </div>
</section>
