---
interface Props {
  eyebrow: string;
  title: string;
  text: string;
}
const { eyebrow, title, text } = Astro.props;
---

<header class="mx-auto max-w-6xl px-4 pt-12 md:px-6">
  <p class="text-xs font-bold uppercase tracking-[0.16em] text-frost">{eyebrow}</p>
  <h1 class="mt-2 max-w-3xl font-serif text-5xl leading-[1.05] md:text-6xl">{title}</h1>
  <p class="mt-4 max-w-2xl text-lg text-ink-soft">{text}</p>
</header>
