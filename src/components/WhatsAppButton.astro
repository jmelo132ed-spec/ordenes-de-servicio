---
import { buildWhatsappUrl } from "../services/whatsapp";
import { site } from "../data/site";

const href = site.whatsapp
  ? buildWhatsappUrl(site.whatsapp, `Hola, quiero un servicio de ${site.name}.`)
  : "/solicitar";
---

<a
  class="fixed right-5 bottom-5 z-40 hidden items-center gap-2 rounded-full bg-whatsapp px-4 py-3 text-sm font-bold text-white shadow-lg lg:inline-flex"
  href={href}
  target={site.whatsapp ? "_blank" : undefined}
  rel={site.whatsapp ? "noopener noreferrer" : undefined}
>
  WhatsApp
</a>

<div class="fixed inset-x-0 bottom-0 z-40 border-t border-line bg-paper/95 p-3 backdrop-blur lg:hidden">
  <div class="grid grid-cols-2 gap-2">
    <a class="rounded-full bg-whatsapp px-3 py-3 text-center text-sm font-bold text-white" href={href} target={site.whatsapp ? "_blank" : undefined} rel={site.whatsapp ? "noopener noreferrer" : undefined}>WhatsApp</a>
    <a class="rounded-full bg-ink px-3 py-3 text-center text-sm font-bold text-white" href="/solicitar">Pedir servicio</a>
  </div>
</div>
