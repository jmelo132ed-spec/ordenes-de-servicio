---
import LogoMark from "./LogoMark.astro";

interface Props {
  tone?: "dark" | "light";
  compact?: boolean;
}
const { tone = "dark", compact = false } = Astro.props;
const word = tone === "light" ? "text-white" : "text-ink";
---

<span class:list={["inline-flex items-center gap-3", word]}>
  <LogoMark class={compact ? "h-12 w-12" : "h-14 w-14"} />
  <span class="leading-none">
    <span class:list={["block font-serif tracking-tight", compact ? "text-[1.45rem]" : "text-[2rem]"]}>Multimarcas</span>
    <span class:list={["block font-bold uppercase", compact ? "mt-1 text-[0.78rem] tracking-[0.16em]" : "mt-1.5 text-[0.9rem] tracking-[0.18em]"]}>Barcelona</span>
  </span>
</span>
