---
import { site } from "../data/site";

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<img
  src="/logo.png"
  alt={site.name}
  width="439"
  height="439"
  decoding="async"
  class:list={[
    "block shrink-0 object-contain",
    compact ? "h-28 w-28 md:h-36 md:w-36" : "h-44 w-44 md:h-52 md:w-52",
  ]}
/>
