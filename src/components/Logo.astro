---
import LogoMark from "./LogoMark.astro";

interface Props {
  tone?: "dark" | "light";
  compact?: boolean;
}
const { tone = "dark", compact = false } = Astro.props;
const word = tone === "light" ? "text-white" : "text-ink";
---

<span class:list={["inline-flex items-center gap-2.5", word]}>
  <LogoMark class={compact ? "h-8 w-8" : "h-9 w-9"} />
  <span class="leading-none">
    <span class="block font-serif text-[1.55rem] tracking-tight">
      <span class="text-ember">Foc</span><span class={tone === "light" ? "text-white/70" : "text-ink-soft"}> i </span><span class="text-frost">Fred</span>
    </span>
    {!compact && <span class="mt-1 block text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-current/70">Barcelona</span>}
  </span>
</span>
