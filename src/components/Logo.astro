---
import LogoMark from "./LogoMark.astro";

interface Props {
  tone?: "dark" | "light";
  compact?: boolean;
}
const { tone = "dark", compact = false } = Astro.props;
const word = tone === "light" ? "text-white" : "text-ink";
---

<span class:list={["inline-flex items-center gap-2.5", word]}>
  <LogoMark class={compact ? "h-8 w-8" : "h-10 w-10"} />
  <span class="leading-none">
    <span class:list={["block font-serif tracking-tight", compact ? "text-[1.05rem]" : "text-[1.65rem]"]}>Multimarcas</span>
    <span class:list={["block font-semibold uppercase text-current/70", compact ? "mt-0.5 text-[0.58rem] tracking-[0.14em]" : "mt-1 text-[0.68rem] tracking-[0.18em]"]}>Barcelona</span>
  </span>
</span>
