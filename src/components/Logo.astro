---
import LogoMark from "./LogoMark.astro";
import { site } from "../data/site";

interface Props {
  tone?: "dark" | "light";
  compact?: boolean;
}
const { tone = "dark", compact = false } = Astro.props;
const word = tone === "light" ? "text-white" : "text-ink";
const [lead, ...rest] = site.name.split(" ");
const tail = rest.join(" ");
---

<span class:list={["inline-flex items-center", compact ? "gap-2.5" : "gap-4", word]}>
  <LogoMark class={compact ? "h-16 w-16" : "h-20 w-20"} />
  <span class="leading-none">
    <span class:list={["block font-serif tracking-tight", compact ? "text-[1.85rem]" : "text-[2.7rem]"]}>{lead}</span>
    <span class:list={["block font-bold uppercase", compact ? "mt-1 text-[0.68rem] tracking-[0.11em]" : "mt-1.5 text-[0.84rem] tracking-[0.14em]"]}>{tail}</span>
  </span>
</span>
