---
import { getFamilies, getServices } from "../services/api";

const families = getFamilies();
const services = await getServices();
---

<section class="mx-auto max-w-6xl px-4 py-16 md:px-6" aria-labelledby="servicios-titulo">
  <div class="max-w-2xl">
    <p class="text-xs font-bold uppercase tracking-[0.16em] text-frost">Qué reparamos, instalamos y vendemos</p>
    <h2 id="servicios-titulo" class="mt-2 font-serif text-4xl text-ink md:text-5xl">Tres familias. Un solo aviso.</h2>
  </div>
  <div class="mt-10 grid gap-12">
    {families.map((family) => {
      const items = services.filter((service) => service.family === family.id);
      return (
        <div>
          <div class="mb-4 flex items-end justify-between gap-4 border-b border-line pb-3">
            <h3 class="font-serif text-2xl">{family.title}</h3>
            <p class="hidden max-w-md text-sm text-ink-soft sm:block">{family.text}</p>
          </div>
          <ul class="grid gap-3 md:grid-cols-2">
            {items.map((service, index) => (
              <li>
                <a class="group flex h-full flex-col rounded-2xl border border-line bg-card p-5 hover:border-ink" href={`/servicios/${service.slug}`}>
                  <span class="text-xs font-bold tracking-[0.14em] text-ember-ink">{String(index + 1).padStart(2, "0")}</span>
                  <span class="mt-3 font-serif text-2xl">{service.name}</span>
                  <span class="mt-1 text-sm text-ink-soft">{service.short}</span>
                  <span class="mt-4 text-sm font-bold text-frost">Pedir este servicio</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      );
    })}
  </div>
</section>
