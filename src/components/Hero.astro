---
import LeadForm from "./LeadForm.astro";
import { site } from "../data/site";
---

<section class="mx-auto grid max-w-6xl items-start gap-10 px-4 pt-10 pb-6 md:px-6 lg:grid-cols-[1.05fr_0.95fr] lg:pt-16">
  <div>
    <p class="text-xs font-bold uppercase tracking-[0.18em] text-ember-ink">Foc i Fred · {site.city}</p>
    <h1 class="mt-3 font-serif text-5xl leading-[1.02] text-ink md:text-7xl">
      Calderas, aire y electrodomésticos.
    </h1>
    <p class="mt-5 max-w-xl text-lg text-ink-soft">
      Instalación, reparación y venta en Barcelona. Gas, gasoil, termos, calentadores, aire doméstico e industrial y línea blanca. Lo pides aquí y nos llega a WhatsApp.
    </p>
    <ul class="mt-6 grid gap-2 text-sm font-semibold text-ink">
      <li class="flex gap-2"><span class="text-ember" aria-hidden="true">●</span> Todas las marcas que se instalan en la ciudad</li>
      <li class="flex gap-2"><span class="text-frost" aria-hidden="true">●</span> Reparar, instalar o comprar el equipo</li>
      <li class="flex gap-2"><span class="text-ink-soft" aria-hidden="true">●</span> Barcelona y área metropolitana</li>
    </ul>
  </div>
  <LeadForm id="pedir" />
</section>
