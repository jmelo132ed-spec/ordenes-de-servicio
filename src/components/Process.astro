---
import { steps } from "../data/mockData";
---

<section class="mx-auto max-w-6xl px-4 py-16 md:px-6" aria-labelledby="pasos-titulo">
  <h2 id="pasos-titulo" class="font-serif text-4xl md:text-5xl">Así de directo.</h2>
  <ol class="mt-8 grid gap-4 md:grid-cols-4">
    {steps.map((step, index) => (
      <li class="rounded-2xl bg-ink p-5 text-white">
        <span class="text-sm font-bold text-ember">{String(index + 1).padStart(2, "0")}</span>
        <h3 class="mt-4 font-serif text-2xl">{step.title}</h3>
        <p class="mt-2 text-sm leading-6 text-white/75">{step.text}</p>
      </li>
    ))}
  </ol>
</section>
