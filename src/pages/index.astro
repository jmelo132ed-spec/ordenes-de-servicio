---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import ServiceBoard from "../components/ServiceBoard.astro";
import BrandMarquee from "../components/BrandMarquee.astro";
import Process from "../components/Process.astro";
import Coverage from "../components/Coverage.astro";
import FaqList from "../components/FaqList.astro";
import CtaBand from "../components/CtaBand.astro";
import { site } from "../data/site";

const title = "Proclima Integral Servicios | Calderas, aire acondicionado y línea blanca en Barcelona";
const description = "Instalación, reparación y venta de calderas de gas y gasoil, termos, calentadores, aire acondicionado, aire industrial y electrodomésticos en Barcelona. Pide el servicio y te llega a WhatsApp.";
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "HVACBusiness",
  name: site.name,
  description,
  url: site.url,
  email: site.email,
  areaServed: [
    { "@type": "City", name: "Barcelona" },
    { "@type": "AdministrativeArea", name: "Àrea Metropolitana de Barcelona" },
  ],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Barcelona",
    addressCountry: "ES",
  },
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <Hero />
  <ServiceBoard />
  <BrandMarquee />
  <Process />
  <Coverage />
  <FaqList />
  <CtaBand
    title="Un equipo averiado no puede esperar."
    text="Cuéntanos la marca y la dirección. La solicitud se abre en WhatsApp y coordinamos la visita."
  />
</Layout>
