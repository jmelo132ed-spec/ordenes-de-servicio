---
import Layout from "../layouts/Layout.astro";
import PageIntro from "../components/PageIntro.astro";
import Coverage from "../components/Coverage.astro";
import CtaBand from "../components/CtaBand.astro";

const title = "Zonas de servicio en Barcelona | Multimarcas Barcelona";
const description = "Atendemos los diez distritos de Barcelona y el área metropolitana: L'Hospitalet, Badalona, Sant Cugat, Cornellà, El Prat, Castelldefels y más.";
---

<Layout title={title} description={description}>
  <PageIntro
    eyebrow="Zonas"
    title="De Gràcia al Prat, y los municipios del alrededor."
    text="Escribe el barrio o el código postal en la solicitud. Si estás en el área metropolitana, también llegamos."
  />
  <div class="py-8">
    <Coverage />
  </div>
  <CtaBand title="Dinos el barrio." text="Con el código postal nos basta para proponerte la visita." href="/solicitar" />
</Layout>
